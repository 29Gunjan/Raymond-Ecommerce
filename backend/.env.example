# Database (Railway provides this automatically when you add PostgreSQL)
DATABASE_URL="postgresql://user:password@host:5432/railway"

# Server
PORT=5000

# JWT Secret (generate a random string)
JWT_SECRET="your-super-secret-jwt-key-min-32-chars"

# Frontend URL (your Railway frontend URL)
FRONTEND_URL=https://your-frontend.up.railway.app

# Google OAuth (optional - get from console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (SMTP) - Get app password from Gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
FROM_EMAIL=your-email@gmail.com
FROM_NAME=Raymond Store

# Razorpay (get from dashboard.razorpay.com)
# Use Live keys for production, Test keys for testing
RAZORPAY_KEY_ID=rzp_live_xxxxx
RAZORPAY_KEY_SECRET=xxxxx
RAZORPAY_WEBHOOK_SECRET=
